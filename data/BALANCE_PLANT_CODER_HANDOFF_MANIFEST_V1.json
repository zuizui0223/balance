{
  "schema_version": "BALANCE_PLANT_CODER_HANDOFF_MANIFEST_V1",
  "status": "READY_FOR_HUMAN_INDEPENDENT_CODING",
  "shared": {
    "codebook": "data/BALANCE_PLANT_MACRO_CODEBOOK_V1.csv",
    "protocol": "docs/BALANCE_PLANT_DOUBLE_CODING_PROTOCOL_V1.md",
    "frozen_coder_ids": [
      "CODER_A",
      "CODER_B"
    ],
    "reliability_trigger_raw_agreement": 0.8,
    "unresolved_is_valid": true,
    "no_consensus_during_independent_coding": true,
    "no_source_adjudication_before_reliability_pass": true,
    "codebook_repair_action": "version codebook and independently recode the SAME frozen reliability groups before adjudication",
    "forbidden_inputs": [
      "other coder output",
      "source-screen conflict decisions",
      "candidate-adjudication rationale",
      "focal architecture outcome as a shortcut for predictor coding"
    ]
  },
  "lanes": {
    "U1": {
      "role": "EXTERNAL_SPECIFICITY_VALIDATION",
      "primary_model_denominator": false,
      "n_dependency_groups_in_reliability_frame": 20,
      "sample": "data/BALANCE_PLANT_U1_DOUBLE_CODE_SAMPLE_V1.csv",
      "source_packet": "data/BALANCE_PLANT_U1_DOUBLE_CODE_SOURCE_PACKET_V1.csv",
      "worksheet": "data/BALANCE_PLANT_U1_DOUBLE_CODE_WORKSHEET_V1.csv",
      "post_coding_adjudication": "data/BALANCE_PLANT_U1_DOUBLE_CODE_ADJUDICATION_TEMPLATE_V1.csv",
      "predictor_receipts": "data/BALANCE_PLANT_U1_CONFIRMATORY_PREDICTOR_RECEIPT_FRAME_V1.csv",
      "current_source_screen": "47 groups; 0 POSITIVE; 46 NO_DEMONSTRATED_CONFLICT; 1 ALIGNED_NO_CONFLICT",
      "predictor_receipt_use": "conditional only if independent adjudication recovers conflict-positive U1 groups"
    },
    "U2": {
      "role": "PRIMARY_ROUTING_UNIVERSE_SEXUAL_INTERFERENCE",
      "primary_model_denominator": true,
      "n_dependency_groups_in_reliability_frame": 20,
      "n_source_screen_conflict_positive": 8,
      "sample": "data/BALANCE_PLANT_U2_DOUBLE_CODE_SAMPLE_V1.csv",
      "source_packet": "data/BALANCE_PLANT_U2_DOUBLE_CODE_SOURCE_PACKET_V1.csv",
      "worksheet": "data/BALANCE_PLANT_U2_DOUBLE_CODE_WORKSHEET_V1.csv",
      "post_coding_adjudication": "data/BALANCE_PLANT_U2_DOUBLE_CODE_ADJUDICATION_TEMPLATE_V1.csv",
      "predictor_receipts": "data/BALANCE_PLANT_U2_CONFIRMATORY_PREDICTOR_RECEIPT_FRAME_V1.csv",
      "current_predictor_screen": "8/8 source-screen positive groups have all three outcome-independent SCREENED predictors; 0/8 independently adjudicated"
    },
    "U6": {
      "role": "PRIMARY_ROUTING_UNIVERSE_POLLEN_THEFT",
      "primary_model_denominator": true,
      "n_dependency_groups_in_reliability_frame": 21,
      "pass1_freeze": "data/BALANCE_PLANT_U6_PASS1_FREEZE_V1.json",
      "source_packet": "data/BALANCE_PLANT_U6_PASS2_FROZEN_SOURCE_PACKET_V1.csv",
      "worksheet": "data/BALANCE_PLANT_U6_PASS2_DOUBLE_CODE_WORKSHEET_V1.csv",
      "post_coding_adjudication": "data/BALANCE_PLANT_U6_PASS2_ADJUDICATION_TEMPLATE_V1.csv",
      "predictor_receipts": "data/BALANCE_PLANT_U6_CONFIRMATORY_PREDICTOR_RECEIPT_FRAME_V1.csv",
      "current_predictor_screen": "21/21 groups have all three outcome-independent SCREENED predictors; 0/21 independently adjudicated",
      "source_recovery": "15 RESOLVED; 6 EVIDENCE_CEILING; 0 pending"
    }
  },
  "return_sequence": [
    "independent worksheets completed without coder communication",
    "category/schema validation",
    "agreement report: raw agreement + Cohen kappa + Gwet AC1 + exact disagreements",
    "if any raw agreement <0.80: codebook repair and independent recoding of same frozen groups",
    "only after reliability pass: source adjudication",
    "separately adjudicate predictor outcome-independence receipts",
    "assemble licensed U2/U6 rows",
    "run V4 estimability gate",
    "fit V4 only if estimable"
  ],
  "current_primary_model": "BALANCE_PLANT_CONFIRMATORY_MODEL_SPEC_V4",
  "current_publication_status": "DORMANT_PAPER_BRANCH",
  "claim_ceiling": "human_coding_handoff_contract_only_no_biological_result",
  "packet_builder": {
    "script": "scripts/build_plant_coder_packets.py",
    "output_root": "release/generated/plant_coder_packets",
    "outputs": [
      "BALANCE_PLANT_CODER_A_PACKET_V1.zip",
      "BALANCE_PLANT_CODER_A_PACKET_V1.json",
      "BALANCE_PLANT_CODER_B_PACKET_V1.zip",
      "BALANCE_PLANT_CODER_B_PACKET_V1.json"
    ],
    "deterministic_zip": true,
    "evidence_identity_rule": "coder A and coder B receive byte-identical codebook/protocol/source packets; only their filtered worksheet rows differ",
    "forbidden_artifact_classes": [
      "source-screen decisions",
      "conflict-screen ledgers",
      "adjudication templates",
      "agreement outputs",
      "predictor-receipt ledgers",
      "reactivation-gate outputs"
    ],
    "workflow": ".github/workflows/build-plant-coder-packets.yml",
    "runbook": "docs/BALANCE_PLANT_CODER_PACKET_RUNBOOK_V1.md",
    "trigger": "workflow_dispatch_only"
  },
  "predictor_adjudication": {
    "protocol": "docs/BALANCE_PLANT_PREDICTOR_RECEIPT_ADJUDICATION_PROTOCOL_V1.md",
    "builder": "scripts/build_plant_predictor_adjudication_packet.py",
    "workflow": ".github/workflows/build-plant-predictor-adjudication-packet.yml",
    "output_artifact": "balance-plant-predictor-adjudication-packet-v1",
    "architecture_outputs_included": false,
    "applicable_primary_universes": [
      "U2",
      "U6"
    ],
    "sequence_rule": "separate from architecture coding; receipts must be adjudicated outcome-independent before V4 assembly"
  },
  "post_handoff_analysis": {
    "readiness_cli": "scripts/build_plant_v4_analysis_inputs.py",
    "manual_workflow": ".github/workflows/build-plant-v4-analysis-inputs.yml",
    "build_command": "python scripts/build_plant_v4_analysis_inputs.py --input-dir <composed-human-workspace> --out-dir <new-analysis-input-workspace> --build",
    "outputs": [
      "BALANCE_PLANT_V4_LICENSED_ASSEMBLY.csv",
      "BALANCE_PLANT_V4_ASSEMBLY_READOUT.json",
      "BALANCE_PLANT_V4_STAN_INPUT.json",
      "BALANCE_PLANT_V4_PRIOR_SENSITIVITY_INPUT.json",
      "BALANCE_PLANT_V4_TEMPORAL_GENERALITY_INPUT.json when the stricter generality gate is ready",
      "BALANCE_PLANT_V4_TEMPORAL_GENERALITY_PRIOR_SENSITIVITY_INPUT.json when the stricter generality gate is ready",
      "BALANCE_PLANT_V4_HUMAN_INPUT_WORKSPACE_RECEIPT_V1.json copied from the validated composed workspace",
      "BALANCE_PLANT_V4_ANALYSIS_INPUTS_RECEIPT_V1.json"
    ],
    "fail_closed_rule": "build is forbidden while any U2/U6 coding, adjudication, predictor-independence, assembly, or V4 estimability gate remains open",
    "fit_execution_contract": "data/BALANCE_PLANT_V4_FIT_EXECUTION_CONTRACT_V1.json",
    "fit_runner": "scripts/run_plant_v4_cmdstan.py",
    "fit_execution_doc": "docs/BALANCE_PLANT_V4_CMDSTAN_EXECUTION_V1.md",
    "provenance_rule": "successful build requires the composed human-workspace receipt, verifies its primary file SHA256 values, writes an immutable analysis-input receipt binding that source receipt to the licensed assembly and every active Stan wrapper, and the fit runner must verify that receipt before CmdStan",
    "manual_workflow_role": "CONTRACT_AND_TRACKED_INPUT_READINESS_VALIDATION_ONLY",
    "production_build_requires_external_composed_workspace": true
  },
  "return_ingestion": {
    "merger_module": "balance_domain/plant_coder_return.py",
    "cli": "scripts/merge_plant_coder_returns.py",
    "rule": "validate each coder return against the frozen lane group set and coder ID, then merge into canonical alternating CODER_A/CODER_B order",
    "tracked_data_overwrite_required": false,
    "recommended_workspace": "release/generated/plant_coder_returns",
    "downstream_analysis_cli": "scripts/build_plant_v4_analysis_inputs.py",
    "downstream_input_option": "--input-dir",
    "mutable_workspace_basenames": [
      "BALANCE_PLANT_U1_DOUBLE_CODE_WORKSHEET_V1.csv",
      "BALANCE_PLANT_U1_DOUBLE_CODE_ADJUDICATION_TEMPLATE_V1.csv",
      "BALANCE_PLANT_U2_DOUBLE_CODE_WORKSHEET_V1.csv",
      "BALANCE_PLANT_U2_DOUBLE_CODE_ADJUDICATION_TEMPLATE_V1.csv",
      "BALANCE_PLANT_U2_CONFIRMATORY_PREDICTOR_RECEIPT_FRAME_V1.csv",
      "BALANCE_PLANT_U6_PASS2_DOUBLE_CODE_WORKSHEET_V1.csv",
      "BALANCE_PLANT_U6_PASS2_ADJUDICATION_TEMPLATE_V1.csv",
      "BALANCE_PLANT_U6_CONFIRMATORY_PREDICTOR_RECEIPT_FRAME_V1.csv"
    ],
    "immutable_repo_inputs": [
      "frozen samples",
      "source packets",
      "U6 Pass-1 freeze",
      "U6 dependence map",
      "model specifications"
    ],
    "fail_closed_rule": "malformed or partial human-return override is never silently replaced by a repo default if that override file exists",
    "intake_contract": "data/BALANCE_PLANT_HUMAN_RETURN_INTAKE_CONTRACT_V1.json",
    "intake_cli": "scripts/audit_plant_human_returns.py",
    "standard_entrypoint": "python scripts/audit_plant_human_returns.py --return-dir <dir>",
    "intake_rule": "accept primary U2/U6 architecture, U1 external-validation architecture, and predictor review as independent complete stages; partial files within a supplied stage fail closed",
    "intake_runbook": "docs/BALANCE_PLANT_HUMAN_RETURN_INTAKE_V1.md",
    "primary_architecture_return_file_count": 4,
    "external_validation_return_file_count": 2,
    "predictor_review_return_file_count": 2,
    "stage_independence_rule": "U1 latency never blocks U2/U6 primary reliability; architecture latency never blocks predictor-review validation; predictor latency never blocks architecture reliability"
  },
  "agreement_reporting": {
    "module": "balance_domain/plant_agreement_report.py",
    "cli": "scripts/report_plant_coder_agreement.py",
    "threshold_raw_agreement": 0.8,
    "outputs": [
      "BALANCE_PLANT_<LANE>_AGREEMENT_REPORT_V1.json",
      "BALANCE_PLANT_<LANE>_DISAGREEMENTS_V1.csv"
    ],
    "low_agreement_action": "CODEBOOK_REPAIR_AND_INDEPENDENT_RECODE_SAME_FROZEN_GROUPS",
    "pass_action": "SOURCE_ADJUDICATION",
    "exact_disagreement_list_required": true,
    "adjudication_allowed_only_if_all_fields_pass": true
  },
  "architecture_adjudication": {
    "contract": "data/BALANCE_PLANT_ARCHITECTURE_ADJUDICATION_HANDOFF_V1.json",
    "protocol": "docs/BALANCE_PLANT_ARCHITECTURE_ADJUDICATION_PROTOCOL_V1.md",
    "module": "balance_domain.plant_architecture_adjudication",
    "packet_cli": "scripts/build_plant_architecture_adjudication_packet.py",
    "return_cli": "scripts/validate_plant_architecture_adjudication.py",
    "primary_scope": {
      "lanes": [
        "U2",
        "U6"
      ],
      "reliability_requirement": "U2_AND_U6_RELIABILITY_PASS",
      "blocks_primary_v4": true
    },
    "external_scope": {
      "lanes": [
        "U1"
      ],
      "reliability_requirement": "U1_RELIABILITY_PASS",
      "blocks_primary_v4": false
    },
    "packet_rule": "include codebook/source packets/merged coding/agreement/exact disagreements/adjudication template; exclude predictor review and fit/publication outputs",
    "return_rule": "validate all rows through canonical lane loaders; coder consensus cannot be overridden; disagreement decisions require source-review basis",
    "workspace_rule": "validated adjudication outputs are written atomically to a new immutable workspace"
  },
  "human_input_composition": {
    "contract": "data/BALANCE_PLANT_V4_HUMAN_INPUT_WORKSPACE_CONTRACT_V1.json",
    "module": "balance_domain.plant_v4_workspace",
    "cli": "scripts/compose_plant_v4_human_workspace.py",
    "required_sources": [
      "validated PRIMARY architecture adjudication workspace",
      "validated COMPLETE predictor-review intake workspace"
    ],
    "optional_source": "validated EXTERNAL U1 architecture adjudication workspace",
    "validation_rule": "copy only receipt-declared validated files, preserve byte identity, rerun canonical V4 readiness, and require zero primary human open gates before atomic rename",
    "downstream_command": "python scripts/build_plant_v4_analysis_inputs.py --input-dir <workspace> --build",
    "external_validation_blocks_primary": false
  }
