{
  "schema_version": "BALANCE_PLANT_V4_FIT_EXECUTION_CONTRACT_V1",
  "status": "FROZEN_PRE_OUTCOME_BEFORE_INDEPENDENT_ARCHITECTURE_CODING",
  "engine": "CMDSTAN_NUTS",
  "command_interface": "CmdStan CLI",
  "primary_model": "comparative/models/BALANCE_PLANT_V4_MULTINOMIAL.stan",
  "temporal_generality_model": "comparative/models/BALANCE_PLANT_V4_TEMPORAL_GENERALITY.stan",
  "fit_jobs": [
    {
      "id": "PRIMARY",
      "input": "BALANCE_PLANT_V4_STAN_INPUT.json",
      "model": "PRIMARY"
    },
    {
      "id": "PRIMARY_PRIOR_SENSITIVITY",
      "input": "BALANCE_PLANT_V4_PRIOR_SENSITIVITY_INPUT.json",
      "model": "PRIMARY"
    },
    {
      "id": "TEMPORAL_GENERALITY",
      "input": "BALANCE_PLANT_V4_TEMPORAL_GENERALITY_INPUT.json",
      "model": "TEMPORAL_GENERALITY",
      "optional_gate": "temporal_generality_status=READY"
    },
    {
      "id": "TEMPORAL_GENERALITY_PRIOR_SENSITIVITY",
      "input": "BALANCE_PLANT_V4_TEMPORAL_GENERALITY_PRIOR_SENSITIVITY_INPUT.json",
      "model": "TEMPORAL_GENERALITY",
      "optional_gate": "temporal_generality_status=READY"
    }
  ],
  "sampling": {
    "chains": 4,
    "num_warmup": 1000,
    "num_samples": 2000,
    "save_warmup": false,
    "thin": 1,
    "adapt_delta": 0.99,
    "max_depth": 15,
    "metric": "diag_e",
    "seed": 20260930,
    "output_sig_figs": 18,
    "refresh": 100
  },
  "diagnostics": {
    "max_divergences": 0,
    "max_treedepth_hits": 0,
    "min_ebfmi": 0.3,
    "max_parameter_rhat": 1.01,
    "min_parameter_ess_bulk": 400,
    "min_parameter_ess_tail": 400,
    "parameter_families": [
      "alpha",
      "beta",
      "gamma_u6_ordered"
    ],
    "failure_action": "STOP_POSTERIOR_DECISION_AND_RECORD_DIAGNOSTIC_FAILURE",
    "automatic_retuning_allowed": false
  },
  "postfit": {
    "assembly_input": "BALANCE_PLANT_V4_LICENSED_ASSEMBLY.csv",
    "primary_summary": "balance_domain.plant_v4_estimands.summarize_v4_primary_postfit",
    "temporal_generality_summary": "balance_domain.plant_v4_estimands.summarize_v4_temporal_generality_postfit",
    "standardization_registry": "data/BALANCE_PLANT_V4_ESTIMAND_STANDARDIZATION_V1.json",
    "posterior_decision_rules": "data/BALANCE_PLANT_V4_POSTERIOR_DECISION_RULES_V1.json"
  },
  "reproducibility": {
    "record_cmdstan_version": true,
    "record_model_sha256": true,
    "record_input_sha256": true,
    "record_chain_csv_sha256": true,
    "record_command_argv": true,
    "record_stansummary_csv": true,
    "required_cmdstan_version": "2.40.0",
    "record_chain_count_and_draw_count": true,
    "record_licensed_assembly_sha256": true,
    "record_analysis_input_receipt_sha256": true,
    "record_source_human_workspace_receipt_sha256": true
  },
  "prohibitions": [
    "do not change chain count, warmup, sampling iterations, seed, adapt_delta, or max_depth after seeing fitted effect signs",
    "do not continue to posterior decision if any registered diagnostic gate fails",
    "do not automatically retune the sampler after a diagnostic failure",
    "do not fit the temporal generality models unless both registered generality input files exist",
    "do not replace the registered probability estimands with raw logit coefficient signs",
    "do not accept missing, duplicated, truncated, or wrong-version chain CSVs",
    "do not evaluate convergence from a stansummary missing any registered model parameter",
    "do not mix V4 input wrappers from different licensed assemblies or pre-fit builds",
    "do not fit temporal-generality inputs when the licensed assembly fails the frozen generality support gate",
    "do not reuse or overwrite a prior V4 fit output directory",
    "do not allow stale optional generality outputs from an earlier run to coexist with a later primary-only fit",
    "do not fit an analysis-input workspace whose provenance receipt or copied human-workspace receipt is missing or hash-inconsistent"
  ],
  "claim_ceiling": "fit_execution_and_diagnostics_contract_only_no_observed_result",
  "required_cmdstan_version": "2.40.0",
  "chain_integrity": {
    "expected_chain_count": 4,
    "expected_postwarmup_draws_per_chain": 2000,
    "unique_chain_paths_required": true,
    "chain_cmdstan_version_must_equal_required": true,
    "stansummary_complete_parameter_set_required": true,
    "primary_parameter_count": 15,
    "generality_parameter_count": 18
  },
  "input_bundle_integrity": {
    "licensed_assembly_required": true,
    "wrappers_must_equal_deterministic_rebuild_from_assembly": true,
    "primary_and_primary_sensitivity_required": true,
    "generality_pair_presence_must_match_assembly_support_gate": true,
    "generality_primary_and_sensitivity_must_exist_together": true,
    "record_licensed_assembly_sha256": true,
    "record_input_wrapper_sha256": true,
    "analysis_input_receipt_required": true,
    "source_human_workspace_receipt_copy_required": true,
    "receipt_hashes_must_match_assembly_and_wrappers": true
  },
  "workspace_policy": {
    "existing_output_directory_overwrite_allowed": false,
    "one_run_per_workspace": true,
    "stale_optional_outputs_forbidden": true,
    "new_run_requires_new_output_directory": true
  }
}
